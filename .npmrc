# pnpm workspace configuration.
#
# auto-install-peers: install missing peer dependencies automatically rather
# than failing the install outright. This is a safety net, not a substitute
# for correct version pins above — every conflict reported in Phase 1's
# dependency review (better-auth/drizzle-orm/drizzle-kit/zod) was fixed by
# an explicit version change in the relevant package.json, documented in
# docs/dependency-audit.md. This setting exists so a future *patch* release
# somewhere in the tree doesn't hard-fail install over a peer range that's
# actually fine to auto-satisfy.
auto-install-peers=true

# Don't hard-fail on peer dependency mismatches pnpm can't resolve
# automatically — surface them as warnings instead. Real conflicts still
# need fixing (see docs/dependency-audit.md); this just prevents an
# unrelated, satisfiable peer warning from blocking `pnpm install` entirely.
strict-peer-dependencies=false
