# --- Database ---
DATABASE_URL=postgresql://bridge:bridge@localhost:5432/bridge_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-value
BETTER_AUTH_URL=http://localhost:3000

# --- Email (dev default: logs to console, see core/email) ---
EMAIL_PROVIDER=console

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- App ---
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
